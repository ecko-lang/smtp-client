# smtp - an SMTP client (RFC 5321) written in pure Ecko.
#
# No native code: SMTP is CRLF lines over std.net's raw sockets (connect /
# connect_tls, send, recv_until), with STARTTLS upgrading the live socket in
# place (net.starttls) - the same plumbing the pure-Ecko DB clients ride.
# AUTH PLAIN is base64 via std.encoding.
#
# The entrypoint of the `smtp` package; `export` declares its public API.

import std.net
import std.encoding
import std.time

# --- pure helpers (covered by the offline tests) ----------------------------

fn to_list(v) = if type_of(v) == "list" { v } else { [v] }

# get with a default: map fields in `server`/`msg` are all optional but one.
fn opt(m, k, d) {
    v = get(m, k)
    if is_null(v) { d } else { v }
}

## addr_of("Ada <ada@x>") -> "ada@x"; a bare address passes through trimmed.
export fn addr_of(s) {
    if contains(s, "<") and contains(s, ">") { split(split(s, "<")[1], ">")[0] } else { trim(s) }
}

## One reply line -> { code, more, text }. "250-x" continues a multiline
## reply; "250 x" (or a bare "250") ends it.
export fn parse_reply_line(line) {
    code = int(line[0..3])
    if len(line) <= 3 {
        { code: code, more: false, text: "" }
    } else {
        { code: code, more: line[3] == "-", text: trim(line[4..len(line)]) }
    }
}

## Normalize line endings to CRLF and escape leading dots (RFC 5321 §4.5.2),
## so a body line of "." can't terminate the DATA phase early.
export fn dot_stuff(text) {
    unified = replace(replace(text, "\r\n", "\n"), "\r", "\n")
    stuffed = map(split(unified, "\n"), fn(l) if starts_with(l, ".") { "." + l } else { l })
    join(stuffed, "\r\n")
}

## The AUTH PLAIN initial response: base64("\0user\0pass").
export fn auth_plain(user, pass) = encoding.base64_encode(
    b"\x00" + bytes(user) + b"\x00" + bytes(pass),
)

## build_message(msg) -> RFC 5322 text (CRLF line endings): From / To /
## Subject [/ Date] / extra headers (sorted by name) / MIME headers, a blank
## line, then the body. msg: { from, to (string|list), subject, body,
## date?, headers? }.
##
## A header supplied in `headers` wins over the default this would otherwise
## add, so a caller sending a multipart body (see the `mime` package) can set
## its own Content-Type without ending up with two of them.
export fn build_message(msg) {
    mut lines = [
        "From: " + msg.from,
        "To: " + join(to_list(msg.to), ", "),
        "Subject: " + msg.subject,
    ]
    date = get(msg, "date")
    unless is_null(date) { lines = push(lines, "Date: " + date) }
    extra = opt(msg, "headers", {})
    # Sorted, because Ecko maps are unordered and the same message must render
    # the same way every time.
    for name in sort(keys(extra)) {
        lines = push(lines, name + ": " + string(get(extra, name)))
    }
    supplied = map(keys(extra), fn(k) lower(k))
    unless contains(supplied, "mime-version") { lines = push(lines, "MIME-Version: 1.0") }
    unless contains(supplied, "content-type") {
        lines = push(lines, "Content-Type: text/plain; charset=utf-8")
    }
    body = replace(replace(msg.body, "\r\n", "\n"), "\r", "\n")
    join(lines, "\r\n") + "\r\n\r\n" + replace(body, "\n", "\r\n")
}

# --- the wire protocol -------------------------------------------------------

## read_reply(sock) -> { code, lines }, collecting a full (possibly
## multiline) server reply.
export fn read_reply(sock) {
    mut lines = []
    loop {
        raw = net.recv_until(sock, b"\r\n")
        parsed = parse_reply_line(string(raw[0..len(raw) - 2]))
        lines = push(lines, parsed.text)
        if not parsed.more { return { code: parsed.code, lines: lines } }
    }
}

## Require the next reply to carry `want`, or throw { kind: "smtp", code }.
export fn expect_code(sock, want, label) {
    reply = read_reply(sock)
    if reply.code != want {
        error(
            {
                kind: "smtp",
                code: reply.code,
                message: label + " failed: " + string(reply.code) + " " + join(reply.lines, " / "),
            },
        )
    }
    reply
}

## Send one command line and require a reply code. Errors are labelled with
## the command VERB only, so AUTH credentials never appear in error text.
export fn command(sock, line, want) {
    net.send(sock, line + "\r\n")
    expect_code(sock, want, split(line, " ")[0])
}

# --- transport selection -----------------------------------------------------

# TLS mode: explicit server.tls ("tls" | "starttls" | "none"), else inferred
# from an explicit port (465 -> tls, 587 -> starttls), else "none".
fn mode_of(server) {
    m = get(server, "tls")
    unless is_null(m) { return m }
    p = get(server, "port")
    if p == 465 { "tls" } else { if p == 587 { "starttls" } else { "none" } }
}

fn port_of(server, mode) {
    p = get(server, "port")
    unless is_null(p) { return p }
    if mode == "tls" { 465 } else { if mode == "starttls" { 587 } else { 25 } }
}

# Stamp a Date header at send time if the caller didn't supply one.
fn stamped(msg) {
    if is_null(get(msg, "date")) {
        insert(msg, "date", time.format(time.now(), "%a, %d %b %Y %H:%M:%S +0000"))
    } else {
        msg
    }
}

# The mock transport: no socket, no Date stamping - returns the envelope and
# the built message deterministically, so examples and tests run offline.
fn mock_send(msg) {
    { mock: true, accepted: to_list(msg.to), data: build_message(msg) }
}

# --- send --------------------------------------------------------------------
##
## send(server, msg) -> { accepted, reply }
##   server: { host, port?, tls?, user?, pass?, verify?, helo?, mock? }
##   msg:    { from, to (string|list), subject, body, date?, headers? }
##
## The password may be a `secret` - it is revealed only for the AUTH exchange.
export fn send(server, msg) {
    if opt(server, "mock", false) == true { return mock_send(msg) }
    mode = mode_of(server)
    port = port_of(server, mode)
    verify = opt(server, "verify", true)
    sock = if mode == "tls" {
        net.connect_tls(server.host, port, { verify: verify })
    } else {
        net.connect(server.host, port)
    }
    expect_code(sock, 220, "greeting")
    helo = opt(server, "helo", "localhost")
    command(sock, "EHLO " + helo, 250)
    if mode == "starttls" {
        command(sock, "STARTTLS", 220)
        net.starttls(sock, { verify: verify })
        command(sock, "EHLO " + helo, 250)
    }
    user = get(server, "user")
    unless is_null(user) {
        pass = get(server, "pass")
        plain = if is_secret(pass) { reveal(pass) } else { pass }
        command(sock, "AUTH PLAIN " + auth_plain(user, plain), 235)
    }
    command(sock, "MAIL FROM:<" + addr_of(msg.from) + ">", 250)
    rcpts = to_list(msg.to)
    for r in rcpts {
        command(sock, "RCPT TO:<" + addr_of(r) + ">", 250)
    }
    command(sock, "DATA", 354)
    mut payload = dot_stuff(build_message(stamped(msg)))
    unless ends_with(payload, "\r\n") { payload = payload + "\r\n" }
    net.send(sock, payload + ".\r\n")
    done = expect_code(sock, 250, "message body")
    try { command(sock, "QUIT", 221) } catch (e) { null }
    net.close(sock)
    { accepted: rcpts, reply: join(done.lines, " ") }
}
